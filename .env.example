# nexierp-golang — contoh env (nilai dev lokal; produksi via deploy)
DATABASE_URL=postgresql://nexierp:***@127.0.0.1:15433/nexierp
REDIS_URL=redis://127.0.0.1:16379

JWT_ACCESS_SECRET=ganti-min-1-char
JWT_REFRESH_SECRET=ganti-min-1-char
JWT_ACCESS_TTL=15m
PK_CIPHER_SECRET=

PORT=3101
NODE_ENV=development

MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_ACCESS_KEY=***
MINIO_SECRET_KEY=***
MINIO_BUCKET=nexierp
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:19000

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

WA_WEBHOOK_URL_PUBLIK=
WA_WEBHOOK_TOKEN=
WA_EVOLUTION_BASE_URL=
WA_EVOLUTION_APIKEY=
WA_LLM_BASE_URL=
WA_LLM_APIKEY=

ECOM_PORTAL_URL=http://localhost:3200
AUTH_TOKEN_SWEEP_INTERVAL_MS=21600000
WA_STATUS_KIRIM_INTERVAL_MS=10000

# raw (tanpa validasi) — persis NestJS
WEB_ORIGIN=http://localhost:3000,http://localhost:3100,http://localhost:3200
PORTAL_ORIGINS=http://localhost:3200
COOKIE_SECURE=false
