{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "exclusiveMinimum": true,
      "minimum": 0
    },
    "userId": {
      "type": "integer",
      "exclusiveMinimum": true,
      "minimum": 0
    },
    "userName": {
      "type": "string",
      "minLength": 1
    },
    "setAt": {
      "type": "string",
      "format": "date-time"
    },
    "maskedHash": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "userId",
    "userName",
    "setAt",
    "maskedHash"
  ],
  "additionalProperties": false
}
