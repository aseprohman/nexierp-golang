{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "method": {
      "type": "string",
      "enum": [
        "get",
        "post",
        "patch",
        "put",
        "delete"
      ]
    },
    "uriPattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "allOf": [
        {
          "pattern": "^\\/"
        },
        {
          "pattern": "^[^\\s?]*$"
        }
      ]
    },
    "permissionCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    }
  },
  "required": [
    "method",
    "uriPattern",
    "permissionCode"
  ],
  "additionalProperties": false
}
