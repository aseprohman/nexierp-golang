{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "userId": {
      "type": "integer",
      "exclusiveMinimum": true,
      "minimum": 0
    },
    "roleCode": {
      "type": "string",
      "minLength": 1
    },
    "assignedBy": {
      "type": "string",
      "minLength": 1
    },
    "assignedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "userId",
    "roleCode",
    "assignedBy",
    "assignedAt"
  ],
  "additionalProperties": false
}
