{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "fileId": {
      "type": "number"
    },
    "kind": {
      "type": "string",
      "enum": [
        "image",
        "pdf",
        "video",
        "audio",
        "file"
      ]
    },
    "url": {
      "type": "string"
    },
    "expiresIn": {
      "type": "number"
    }
  },
  "required": [
    "id",
    "fileId",
    "kind",
    "url",
    "expiresIn"
  ],
  "additionalProperties": false
}
