{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "exclusiveMinimum": true,
      "minimum": 0
    },
    "roleId": {
      "type": "integer",
      "exclusiveMinimum": true,
      "minimum": 0
    },
    "menuId": {
      "type": "integer",
      "exclusiveMinimum": true,
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "roleId",
    "menuId",
    "createdAt"
  ],
  "additionalProperties": false
}
