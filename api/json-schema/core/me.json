{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "user": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "exclusiveMinimum": true,
          "minimum": 0
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "username",
        "name"
      ],
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "menus": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": true,
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "urlPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "order": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "externalHref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "text",
          "urlPath",
          "order",
          "icon",
          "externalHref"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "user",
    "roles",
    "permissions",
    "menus"
  ],
  "additionalProperties": false
}
