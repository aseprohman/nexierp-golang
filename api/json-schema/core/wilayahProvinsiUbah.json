{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "kode": {
      "type": "string",
      "pattern": "^\\d{2}$"
    },
    "nama": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": false
}
