{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "number"
    },
    "idCoreModules": {
      "type": "number"
    },
    "key": {
      "type": "string",
      "enum": [
        "inventory",
        "accounting",
        "sales",
        "finance",
        "hr",
        "crm",
        "whatsapp-crm",
        "book",
        "pos",
        "purchasing",
        "asset",
        "ess",
        "fnb",
        "system",
        "payment-gateway",
        "shipment",
        "ecom",
        "wf",
        "ai-llm"
      ]
    },
    "name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "fiturIds": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    }
  },
  "required": [
    "id",
    "idCoreModules",
    "key",
    "name",
    "tagline",
    "enabled",
    "fiturIds"
  ],
  "additionalProperties": false
}
