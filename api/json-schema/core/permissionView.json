{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "exclusiveMinimum": true,
      "minimum": 0
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "moduleKey": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "inventory",
            "accounting",
            "sales",
            "finance",
            "hr",
            "crm",
            "whatsapp-crm",
            "book",
            "pos",
            "purchasing",
            "asset",
            "ess",
            "fnb",
            "system",
            "payment-gateway",
            "shipment",
            "ecom",
            "wf",
            "ai-llm"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ]
    },
    "isSystem": {
      "type": "boolean"
    },
    "routeCount": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "moduleKey",
    "status",
    "isSystem",
    "routeCount",
    "createdAt"
  ],
  "additionalProperties": false
}
