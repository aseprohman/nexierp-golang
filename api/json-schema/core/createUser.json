{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9_.-]+$"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "fullName": {
      "type": "string",
      "minLength": 1
    },
    "department": {
      "type": "string",
      "minLength": 1
    },
    "roleIds": {
      "type": "array",
      "items": {
        "type": "integer",
        "exclusiveMinimum": true,
        "minimum": 0
      },
      "minItems": 1
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "username",
    "fullName",
    "department",
    "roleIds"
  ],
  "additionalProperties": false
}
