{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "exclusiveMinimum": true,
      "minimum": 0
    },
    "definition_id": {
      "type": "integer",
      "exclusiveMinimum": true,
      "minimum": 0
    },
    "role_id": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": true,
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "user_id": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": true,
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "role_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "username": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_active": {
      "type": "boolean"
    },
    "note": {
      "type": "string",
      "maxLength": 200
    },
    "value_count": {
      "type": "integer",
      "minimum": 0
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "values": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "id",
    "definition_id",
    "role_id",
    "user_id",
    "role_name",
    "username",
    "is_active",
    "note",
    "value_count",
    "version"
  ],
  "additionalProperties": false
}
