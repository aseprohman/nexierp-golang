{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ]
    },
    "moduleKey": {
      "type": [
        "string",
        "null"
      ]
    },
    "featuresFolder": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
