{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "exclusiveMinimum": true,
      "minimum": 0
    },
    "userId": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": true,
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "usernameTried": {
      "type": "string",
      "minLength": 1
    },
    "success": {
      "type": "boolean"
    },
    "failReason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "unknown_user",
            "wrong_password",
            "locked",
            "inactive",
            "mfa_failed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "ipAddress": {
      "type": "string",
      "minLength": 1
    },
    "userAgent": {
      "type": "string",
      "minLength": 1
    },
    "attemptedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "userId",
    "usernameTried",
    "success",
    "failReason",
    "ipAddress",
    "userAgent",
    "attemptedAt"
  ],
  "additionalProperties": false
}
