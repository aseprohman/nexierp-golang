{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "number"
    },
    "key": {
      "type": "string",
      "enum": [
        "inventory",
        "accounting",
        "sales",
        "finance",
        "hr",
        "crm",
        "whatsapp-crm",
        "book",
        "pos",
        "purchasing",
        "asset",
        "ess",
        "fnb",
        "system",
        "payment-gateway",
        "shipment",
        "ecom",
        "wf",
        "ai-llm"
      ]
    },
    "name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "fitur": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "featuresFolder": {
            "type": "string"
          },
          "description": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "featuresFolder"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "key",
    "name",
    "tagline",
    "enabled",
    "fitur"
  ],
  "additionalProperties": false
}
