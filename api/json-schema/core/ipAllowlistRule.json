{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "exclusiveMinimum": true,
      "minimum": 0
    },
    "roleCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "userId": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": true,
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "cidr": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "roleCode",
    "userId",
    "target",
    "cidr",
    "note",
    "createdAt"
  ],
  "additionalProperties": false
}
