{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "currentPassword": {
      "type": "string",
      "minLength": 1
    },
    "newPassword": {
      "type": "string",
      "minLength": 8
    },
    "confirmPassword": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "currentPassword",
    "newPassword",
    "confirmPassword"
  ],
  "additionalProperties": false
}
