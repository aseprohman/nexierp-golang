{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "userId": {
      "type": "integer",
      "minimum": 1
    },
    "permissionId": {
      "type": "integer",
      "minimum": 1
    },
    "granted": {
      "type": "boolean"
    },
    "expiresAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "userId",
    "permissionId",
    "granted"
  ],
  "additionalProperties": false
}
