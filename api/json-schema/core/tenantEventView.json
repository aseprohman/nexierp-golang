{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "exclusiveMinimum": true,
      "minimum": 0
    },
    "aksi": {
      "type": "string",
      "minLength": 1
    },
    "payload": {},
    "aktor": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "aksi",
    "aktor",
    "createdAt"
  ],
  "additionalProperties": false
}
