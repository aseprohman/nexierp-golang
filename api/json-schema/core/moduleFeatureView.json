{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "exclusiveMinimum": true,
      "minimum": 0
    },
    "moduleKey": {
      "type": "string",
      "enum": [
        "inventory",
        "accounting",
        "sales",
        "finance",
        "hr",
        "crm",
        "whatsapp-crm",
        "book",
        "pos",
        "purchasing",
        "asset",
        "ess",
        "fnb",
        "system",
        "payment-gateway",
        "shipment",
        "ecom",
        "wf",
        "ai-llm"
      ]
    },
    "featuresFolder": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "isActive": {
      "type": "boolean"
    },
    "isSystem": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "moduleKey",
    "featuresFolder",
    "isActive",
    "isSystem"
  ],
  "additionalProperties": false
}
