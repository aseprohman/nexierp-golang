{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "accessToken": {
      "type": "string",
      "minLength": 10
    },
    "refreshToken": {
      "type": "string",
      "minLength": 10
    },
    "expiresIn": {
      "type": "integer",
      "exclusiveMinimum": true,
      "minimum": 0
    }
  },
  "required": [
    "accessToken",
    "refreshToken"
  ],
  "additionalProperties": false
}
